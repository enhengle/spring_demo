<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 从Spring配置中获取日志目录 -->
    <springProperty scope="context" name="LOG_DIR" source="common.logDir" defaultValue="./logs"/>
    
    <!-- 日志格式定义 -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="LOG_CHARSET" value="UTF-8"/>
    
    <!-- 日志文件路径 -->
    <property name="LOG_FILE_PATH" value="${LOG_DIR}/application"/>
    <property name="ERROR_LOG_FILE_PATH" value="${LOG_DIR}/error"/>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- 普通日志文件（INFO及以上级别，排除WARN和ERROR） -->
    <appender name="FILE_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 日志文件路径 -->
        <file>${LOG_FILE_PATH}.log</file>
        
        <!-- 日志滚动策略：按日期和大小切割 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 日志文件命名模式：按日期和序号 -->
            <fileNamePattern>${LOG_FILE_PATH}-%d{yyyy-MM-dd}-%i.log</fileNamePattern>
            <!-- 单个日志文件最大大小 -->
            <maxFileSize>100MB</maxFileSize>
            <!-- 日志文件保留天数 -->
            <maxHistory>30</maxHistory>
            <!-- 所有日志文件总大小限制 -->
            <totalSizeCap>10GB</totalSizeCap>
            <!-- 启动时清理过期日志 -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        
        <!-- 日志格式 -->
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
        
        <!-- 过滤器：只记录INFO和DEBUG级别 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>DENY</onMatch>
        </filter>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
        </filter>
    </appender>

    <!-- 错误日志文件（WARN和ERROR级别） -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 错误日志文件路径 -->
        <file>${ERROR_LOG_FILE_PATH}.log</file>
        
        <!-- 日志滚动策略：按日期和大小切割 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 错误日志文件命名模式：按日期和序号 -->
            <fileNamePattern>${ERROR_LOG_FILE_PATH}-%d{yyyy-MM-dd}-%i.log</fileNamePattern>
            <!-- 单个错误日志文件最大大小 -->
            <maxFileSize>100MB</maxFileSize>
            <!-- 错误日志文件保留天数（错误日志保留更长时间） -->
            <maxHistory>90</maxHistory>
            <!-- 所有错误日志文件总大小限制 -->
            <totalSizeCap>5GB</totalSizeCap>
            <!-- 启动时清理过期日志 -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        
        <!-- 日志格式 -->
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
        
        <!-- 过滤器：只记录WARN和ERROR级别 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
    </appender>

    <!-- 异步输出（提高性能） -->
    <appender name="ASYNC_FILE_INFO" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 不丢失日志，默认如果队列80%已满，会丢弃TRACE、DEBUG、INFO级别日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 队列大小 -->
        <queueSize>512</queueSize>
        <!-- 引用上面的FILE_INFO -->
        <appender-ref ref="FILE_INFO"/>
    </appender>

    <appender name="ASYNC_FILE_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 不丢失日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 队列大小 -->
        <queueSize>256</queueSize>
        <!-- 引用上面的FILE_ERROR -->
        <appender-ref ref="FILE_ERROR"/>
    </appender>

    <!-- 开发环境配置 -->
    <springProfile name="dev">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE_INFO"/>
            <appender-ref ref="ASYNC_FILE_ERROR"/>
        </root>
        <!-- 项目包日志级别 -->
        <logger name="com.practise.demo" level="DEBUG"/>
    </springProfile>

    <!-- 测试环境配置 -->
    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE_INFO"/>
            <appender-ref ref="ASYNC_FILE_ERROR"/>
        </root>
        <!-- 项目包日志级别 -->
        <logger name="com.practise.demo" level="INFO"/>
    </springProfile>

    <!-- 生产环境配置 -->
    <springProfile name="prod">
        <root level="INFO">
            <!-- 生产环境不输出到控制台 -->
            <appender-ref ref="ASYNC_FILE_INFO"/>
            <appender-ref ref="ASYNC_FILE_ERROR"/>
        </root>
        <!-- 项目包日志级别 -->
        <logger name="com.practise.demo" level="INFO"/>
        <!-- 第三方框架日志级别 -->
        <logger name="org.springframework" level="WARN"/>
        <logger name="com.baomidou.mybatisplus" level="WARN"/>
    </springProfile>
</configuration>
